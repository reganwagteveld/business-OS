{
  "name": "@business-os/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Native desktop app for Windows and macOS: a Tauri 2 shell around the shared client app. Talks to the cloud API over HTTPS only; never to PostgreSQL.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "tauri": "tauri",
    "tauri:config": "node scripts/tauri-config.mjs",
    "tauri:build": "node scripts/tauri-config.mjs && tauri build --config src-tauri/tauri.generated.conf.json"
  },
  "dependencies": {
    "@business-os/app": "workspace:*",
    "@business-os/ui": "workspace:*",
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
