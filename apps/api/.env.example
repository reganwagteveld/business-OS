DATABASE_URL=postgresql://bos_app:bos_local_app_password@localhost:5432/business_os?schema=public
# --- Migration tooling only (prisma migrate, migration check, integration tests). The running API
# never reads these and they must NOT be set in Vercel (docs/deployment.md §3). ---
MIGRATION_DATABASE_URL=postgresql://bos_owner:bos_local_owner_password@localhost:5432/business_os?schema=public
SHADOW_DATABASE_URL=postgresql://bos_owner:bos_local_owner_password@localhost:5432/business_os_shadow?schema=public
APP_BASE_URL=http://localhost:3000
REGION=us-east-1
DATABASE_REGION=us-east-1
# Origins of the browser app (Vite dev) and the desktop app (Tauri dev server, macOS, Windows).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:1420,tauri://localhost,http://tauri.localhost
# --- RLS spike / isolation tests only (pnpm test:isolation, docs/data-model.md §5.4). Local and CI
# credentials; the app never reads these. The pooler is docker/pgbouncer (transaction mode). ---
SPIKE_ADMIN_URL=postgresql://postgres:local_postgres_only@localhost:5432/business_os_spike
SPIKE_OWNER_URL=postgresql://bos_owner:bos_local_owner_password@localhost:5432/business_os_spike
SPIKE_APP_URL=postgresql://bos_app:bos_local_app_password@127.0.0.1:6433/business_os_spike
SPIKE_APP_SINGLE_URL=postgresql://bos_app:bos_local_app_password@127.0.0.1:6433/spike_single
SPIKE_JOBS_URL=postgresql://bos_jobs:bos_local_jobs_password@127.0.0.1:6433/business_os_spike
