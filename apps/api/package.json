{
  "name": "@business-os/api",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud API and backend (Next.js route handlers). The only workspace package that may access PostgreSQL.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate && prisma generate --schema tests/isolation/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:check-migrations": "node scripts/check-migrations.mjs",
    "postinstall": "prisma generate && prisma generate --schema tests/isolation/prisma/schema.prisma",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "test:isolation": "vitest run --config vitest.isolation.config.ts"
  },
  "dependencies": {
    "@business-os/contracts": "workspace:*",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^16.6.0",
    "next": "^16.0.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prisma": "^7.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
