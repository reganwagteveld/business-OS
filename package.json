{
  "name": "business-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "boundaries": "node scripts/check-boundaries.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:up": "docker compose up -d --wait",
    "setup": "pnpm db:up && pnpm db:generate"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "^8.16.0",
    "zod": "4.6.7",
    "tailwindcss": "4.3.5",
    "@tailwindcss/postcss": "4.3.5",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pg": "^8.15.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "vitest": "5.1.0",
    "dependency-cruiser": "^17.0.0",
    "postcss": "^8.5.0"
  }
}
