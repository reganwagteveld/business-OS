      "path": "/api/v1/auth/request-password-reset",
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "redirectTo": {
            "type": "string",
            "format": "starts_with",
            "pattern": "^\\/.*"
          }
        },
        "required": [
          "email",
          "redirectTo"
        ],
        "additionalProperties": false
      }
    },
    "resetPassword": {
      "method": "POST",
      "path": "/api/v1/auth/reset-password",
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 16,
            "maxLength": 256
          },
          "newPassword": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "newPassword"
        ],
        "additionalProperties": false
      }
    },
    "sendVerificationEmail": {
      "method": "POST",
      "path": "/api/v1/auth/send-verification-email"
    },
    "desktopAuthorize": {
      "method": "GET",
      "path": "/api/v1/auth/desktop/authorize"
    }
  }
}
