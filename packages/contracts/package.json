{
  "name": "@business-os/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "API contracts shared by the API and every client: endpoint definitions and zod schemas. No server code, no secrets.",
  "type": "module",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "typecheck": "tsc --noEmit",
