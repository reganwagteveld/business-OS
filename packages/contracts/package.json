    "check": "node --experimental-strip-types scripts/generate-json-schema.ts --check"
  },
  "dependencies": { "zod": "^4.0.0" },
  "devDependencies": { "eslint": "^9.0.0", "typescript": "^5.9.0", "vitest": "^3.2.0", "@types/node": "^24.0.0" }
}
