{
  "name": "@business-os/visual",
  "version": "0.1.0",
  "private": true,
  "description": "Dev-only visual-regression harness (UI V2-B2-1): the real shared App against the in-memory test fakes, captured as lossless Chromium goldens. Never built or shipped; evidence only, not a substitute for WKWebView or WebView2 checks.",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "visual": "playwright test",
    "visual:update": "playwright test --update-snapshots",
    "visual:docker": "sh scripts/docker.sh",
    "visual:docker:update": "sh scripts/docker.sh --update-snapshots",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@business-os/app": "workspace:*",
    "@business-os/ui": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
